# Source preparation pipeline to be run from mapterhorn/pipelines folder.
# Real (non-trial) coverage for Sapporo + Mt. Moiwa (札幌+藻岩山) --
# the second geographically-scoped city build this session, chosen
# deliberately for a different terrain character than Hakodate (inland
# flat city plain plus a single isolated mountain, vs. Hakodate's
# peninsula/coastline). Scope approximation (no real administrative
# boundary available): lon 141.25-141.45, lat 42.98-43.15, within 1st-
# level mesh block 6441 (R3-5/C2-4). 360 files, all confirmed published
# via `aws s3 ls --profile source-coop` at build time.
# source_to_cog.py deliberately skipped (LERC re-encode not needed for
# already-tiled/compressed input, see japan-geotiff-dem's DECISIONS.md).
[no-cd]
default:
    uv run python source_download.py jpsapporo1
    uv run python source_bounds.py jpsapporo1
    uv run python source_polygonize.py jpsapporo1 4
